generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── User Model ─────────────────────────────────────────────────────────────
model User {
  id              String        @id @default(uuid())
  firstName       String?
  lastName        String?
  name            String
  email           String        @unique
  passwordHash    String
  role            String        @default("customer") // "admin" | "vendor" | "customer"
  companyName     String?
  productCategory String?
  gstNo           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  products        Product[]
  rentalOrders    RentalOrder[]
}

// ─── Category Model ──────────────────────────────────────────────────────────
model Category {
  id         String      @id @default(cuid())
  name       String
  products   Product[]
  attributes Attribute[]
}

// ─── Attribute Model ──────────────────────────────────────────────────────────
model Attribute {
  id         String           @id @default(cuid())
  name       String
  categoryId String
  category   Category         @relation(fields: [categoryId], references: [id])
  values     AttributeValue[]
}

// ─── AttributeValue Model ─────────────────────────────────────────────────────
model AttributeValue {
  id          String                         @id @default(cuid())
  attributeId String
  attribute   Attribute                      @relation(fields: [attributeId], references: [id])
  value       String
  variants    ProductVariantAttributeValue[]
}

// ─── Product Model ───────────────────────────────────────────────────────────
model Product {
  id              String           @id @default(uuid())
  name            String
  description     String
  category        String
  image           String // image path or SVG illustration
  imageUrl        String? // uploaded image URL (from /api/upload)
  rentalUnit      String           @default("day") // "hour" | "day" | "week" | "month"
  price           Float // per rental unit
  securityDeposit Float
  inStock         Int
  vendorId        String?
  vendor          User?            @relation(fields: [vendorId], references: [id])
  categoryId      String? // optional FK to Category model
  categoryRef     Category?        @relation(fields: [categoryId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orderLines      OrderLine[]
  variants        ProductVariant[]
}

// ─── ProductVariant Model ─────────────────────────────────────────────────────
model ProductVariant {
  id              String                         @id @default(cuid())
  productId       String
  product         Product                        @relation(fields: [productId], references: [id])
  sku             String
  price           Float
  stock           Int
  attributeValues ProductVariantAttributeValue[]
}

// ─── ProductVariantAttributeValue (join table) ────────────────────────────────
model ProductVariantAttributeValue {
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id])

  @@id([variantId, attributeValueId])
}

// ─── Product Attribute Model ──────────────────────────────────────────────────
model ProductAttribute {
  id          String   @id @default(uuid())
  name        String
  displayType String   @default("radio") // "radio" | "pills" | "select"
  values      String // JSON string of options
  createdAt   DateTime @default(now())
}

// ─── Quotation Template Model ─────────────────────────────────────────────────
model QuotationTemplate {
  id            String   @id @default(uuid())
  name          String
  validityDays  Int      @default(30)
  paymentTerms  String   @default("Immediate Payment")
  templateLines String // JSON array of default products & quantities
  createdAt     DateTime @default(now())
}

// ─── Rental Order Model (Quotation / Sale Order) ─────────────────────────────
// Status: "QUOTATION" | "QUOTATION_SENT" | "CONFIRMED" | "PICKED_UP" | "RETURNED" | "CANCELLED" | "OVERDUE"
// Invoice Status: "NOTHING_TO_INVOICE" | "WAITING_TO_INVOICE" | "DRAFT_INVOICE" | "POSTED" | "PAID"
model RentalOrder {
  id              String      @id @default(uuid())
  orderNumber     String      @unique // e.g., SO00001
  customerId      String?
  customer        User?       @relation(fields: [customerId], references: [id])
  customerName    String
  invoiceAddress  String?
  deliveryAddress String?
  rentalStart     String // YYYY-MM-DD format
  rentalEnd       String // YYYY-MM-DD format
  deliveryMethod  String      @default("delivery") // "pickup" | "delivery"
  priceList       String      @default("Standard")
  status          String      @default("QUOTATION")
  invoiceStatus   String      @default("NOTHING_TO_INVOICE")
  untaxedAmount   Float       @default(0)
  taxAmount       Float       @default(0)
  totalAmount     Float       @default(0)
  depositAmount   Float       @default(0)
  depositStatus   String      @default("held") // "held" | "refunded" | "partially-deducted"
  lateFeeCharged  Float       @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderLines      OrderLine[]
  invoices        Invoice[]
}

// ─── Order Line Model ────────────────────────────────────────────────────────
model OrderLine {
  id            String      @id @default(uuid())
  rentalOrderId String
  rentalOrder   RentalOrder @relation(fields: [rentalOrderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Int         @default(1)
  unitPrice     Float
  taxPercent    Float       @default(10)
  amount        Float
}

// ─── Invoice Model ───────────────────────────────────────────────────────────
// Status: "DRAFT" | "POSTED" | "PAID"
model Invoice {
  id            String      @id @default(uuid())
  invoiceNumber String      @unique // e.g., INV/2026/0001
  rentalOrderId String
  rentalOrder   RentalOrder @relation(fields: [rentalOrderId], references: [id])
  invoiceDate   String
  status        String      @default("DRAFT")
  untaxedAmount Float       @default(0)
  taxAmount     Float       @default(0)
  totalAmount   Float       @default(0)
  amountPaid    Float       @default(0)
  createdAt     DateTime    @default(now())
}

// ─── Late Fee & Settings Configuration ───────────────────────────────────────
model PickupReturnSetting {
  id               String   @id @default("default")
  dailyRate        Float    @default(15)
  hourlyRate       Float    @default(2.5)
  gracePeriodDays  Int      @default(1)
  enableVendors    Boolean  @default(true)
  enableAttributes Boolean  @default(true)
  enablePriceLists Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

// Backwards compatibility alias for existing query logic
model LateFeeConfig {
  id              String   @id @default("default")
  dailyRate       Float    @default(15)
  gracePeriodDays Int      @default(1)
  updatedAt       DateTime @updatedAt
}
